# Base URL of your Planka instance. Must use https for public hosts;
# plain http is accepted for local/private-network hosts (localhost and
# private IPs such as 10.x, 172.16-31.x, 192.168.x, 169.254.x, 100.64.x-127.x
# (Tailscale), fe80::, fc00::).
PLANKA_API_URL="your-planka-endpoint"

# Planka API key, sent as the X-Api-Key header on every request.
PLANKA_API_KEY="your-planka-api-key"

# Optional: log level for the process (DEBUG, INFO, WARNING, ERROR).
# Default: INFO
PLANKA_LOG_LEVEL="INFO"

# Optional: maximum size in bytes of a response body accepted from Planka.
# Default: 10485760 (10 MiB)
PLANKA_MAX_RESPONSE_BYTES="10485760"
